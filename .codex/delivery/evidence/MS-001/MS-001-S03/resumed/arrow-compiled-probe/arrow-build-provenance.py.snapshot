"""Observe actual Ninja compiler dependencies and static archive members.

The output establishes compilation inputs, not vulnerability applicability or a
license waiver. Caller binds this observation to the resulting wheel ELF bytes.
"""
from __future__ import annotations

import hashlib
import re
import subprocess
from pathlib import Path
from typing import Any


def file_record(path: Path, name: str) -> dict[str, Any]:
    if not path.is_file() or path.is_symlink():
        raise ValueError("Missing regular compilation input")
    with path.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    return {"path": name, "sha256": digest, "size_bytes": path.stat().st_size}


def parse_dependencies(raw: str) -> list[tuple[str, list[str]]]:
    result: list[tuple[str, list[str]]] = []
    target: str | None = None
    expected = 0
    paths: list[str] = []

    def finish() -> None:
        if target is not None:
            if len(paths) != expected:
                raise ValueError("Incomplete compiler dependency record")
            result.append((target, paths.copy()))

    for line in raw.splitlines():
        if not line:
            continue
        if line.startswith("    "):
            if target is None:
                raise ValueError("Orphan compiler dependency")
            paths.append(line[4:])
        else:
            finish()
            match = re.fullmatch(r"(.+): #deps ([0-9]+), deps mtime [0-9]+ \(VALID\)", line)
            if match is None:
                raise ValueError("Stale or unsupported compiler dependency record")
            target, expected = match[1], int(match[2])
            paths = []
    finish()
    return result


def observe(source: Path, build: Path, internal: list[dict[str, Any]]) -> dict[str, Any]:
    source, build = source.resolve(), build.resolve()

    def name(path: Path) -> str | None:
        for base, prefix in ((source, "arrow-source/"), (build, "arrow-build/")):
            if path.is_relative_to(base):
                return prefix + path.relative_to(base).as_posix()
        return None

    inputs: dict[str, dict[str, Any]] = {}
    objects: list[dict[str, Any]] = []
    build_directories: list[str] = []
    for ninja in sorted(build.rglob("build.ninja")):
        directory = ninja.parent
        raw = subprocess.check_output(["ninja", "-C", str(directory), "-t", "deps"], text=True)
        build_directories.append(name(directory) or "arrow-build/")
        for target, dependencies in parse_dependencies(raw):
            output = (directory / target).resolve()
            output_name = name(output)
            if output_name is None:
                raise ValueError("Compilation output outside owned build")
            selected: list[str] = []
            for dependency in dependencies:
                path = (directory / dependency).resolve()
                path_name = name(path)
                if path_name is not None:
                    if path_name not in inputs:
                        inputs[path_name] = file_record(path, path_name)
                    selected.append(path_name)
            if selected:
                objects.append({**file_record(output, output_name), "inputs": sorted(set(selected))})
    if not objects:
        raise ValueError("Missing actual compiler dependency records")
    internal_coverage: list[dict[str, Any]] = []
    for component in internal:
        for item in component["files"]:
            if file_record(source / item["path"], item["path"]) != item:
                raise ValueError("Arrow vendored source modified")
        selected = sorted("arrow-source/" + item["path"] for item in component["files"]
                          if "arrow-source/" + item["path"] in inputs)
        if not selected:
            raise ValueError("Missing compiled vendored component: " + component["name"])
        internal_coverage.append({"name": component["name"], "inputs": selected,
                                  "objects": [row["path"] for row in objects if set(row["inputs"]) & set(selected)]})
    archives: list[dict[str, Any]] = []
    for path in sorted(build.rglob("*.a")):
        members = subprocess.check_output(["ar", "t", str(path)], text=True).splitlines()
        if not members:
            raise ValueError("Empty static archive")
        archives.append({**file_record(path, name(path) or ""), "members": members})
    return {"schema_version": 1, "method": "ninja-actual-deps-and-ar-members/v1",
            "build_directories": build_directories, "inputs": [inputs[key] for key in sorted(inputs)],
            "objects": objects, "static_archives": archives, "internal_coverage": internal_coverage}
