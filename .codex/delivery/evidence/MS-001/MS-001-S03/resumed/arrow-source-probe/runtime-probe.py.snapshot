from datetime import UTC, datetime
from decimal import Decimal
from pathlib import Path
from tempfile import TemporaryDirectory
import json
import pyarrow as pa
import pyarrow.parquet as pq
import pyarrow.fs as fs

rows = [{"id": 1, "value": Decimal("123.45"), "at": datetime(2026, 9, 8, 1, 2, 3, 123456, tzinfo=UTC)},
        {"id": 2, "value": None, "at": None}]
table = pa.Table.from_pylist(rows)
with TemporaryDirectory() as directory:
    target = Path(directory) / "data.parquet"
    pq.write_table(table, target, version="2.6", compression="zstd", write_statistics=True)
    restored = pq.read_table(target, filesystem=fs.LocalFileSystem())
    assert restored.equals(table) and restored.to_pylist() == rows
    meta = pq.ParquetFile(target).metadata
    assert meta.format_version == "2.6"
    assert all(meta.row_group(0).column(i).compression == "ZSTD" for i in range(meta.num_columns))
    assert all(meta.row_group(0).column(i).is_stats_set for i in range(meta.num_columns))
    assert meta.row_group(0).column(0).statistics.min == 1
    batches = table.to_batches(max_chunksize=1)
    assert len(batches) == 2 and all(isinstance(batch, pa.RecordBatch) for batch in batches)
    sink = pa.BufferOutputStream()
    with pa.ipc.new_stream(sink, table.schema) as writer:
        for batch in batches:
            writer.write_batch(batch)
    assert pa.ipc.open_stream(sink.getvalue()).read_all().equals(table)
    ipc = Path(directory) / "data.arrow"
    with pa.OSFile(str(ipc), "wb") as sink:
        with pa.ipc.new_file(sink, table.schema) as writer:
            writer.write_table(table)
    with pa.memory_map(str(ipc), "r") as source:
        assert pa.ipc.open_file(source).read_all().equals(table)
    old = pq.read_table('/probe/old.parquet')
    assert old.equals(table)
print(json.dumps({"schema":1,"platform":"linux/arm64","pyarrow":pa.__version__,
                  "checks":["local-filesystem","parquet-2.6","zstd","column-statistics","decimal",
                            "utc-timestamps","nulls","record-batches","ipc-stream","ipc-file-mmap","prebuilt-wheel-artifact-read"],
                  "result":"pass"}))
