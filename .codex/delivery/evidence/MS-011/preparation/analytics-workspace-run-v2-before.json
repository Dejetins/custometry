{
  "$defs": {
    "CalendarRef": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "content_hash"
      ],
      "title": "CalendarRef",
      "type": "object"
    },
    "MetricRef": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "version_id",
        "content_hash"
      ],
      "title": "MetricRef",
      "type": "object"
    },
    "QueryContext": {
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "store_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Store Ids"
        }
      },
      "required": [
        "starts_on",
        "ends_on",
        "store_ids"
      ],
      "title": "QueryContext",
      "type": "object"
    },
    "StoreBoolean": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "and",
            "or"
          ],
          "title": "Kind",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "and": "#/$defs/StoreBoolean",
                "not": "#/$defs/StoreNot",
                "or": "#/$defs/StoreBoolean",
                "store_in": "#/$defs/StoreSelection"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StoreSelection"
              },
              {
                "$ref": "#/$defs/StoreBoolean"
              },
              {
                "$ref": "#/$defs/StoreNot"
              }
            ]
          },
          "minItems": 1,
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "children"
      ],
      "title": "StoreBoolean",
      "type": "object"
    },
    "StoreFilterV1": {
      "additionalProperties": false,
      "properties": {
        "semantic_dataset_version_id": {
          "format": "uuid",
          "title": "Semantic Dataset Version Id",
          "type": "string"
        },
        "schema_version": {
          "const": "store-filter/v1",
          "default": "store-filter/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_rule": {
          "const": "authorized-store-set/v1",
          "default": "authorized-store-set/v1",
          "title": "Semantic Rule",
          "type": "string"
        },
        "expression": {
          "discriminator": {
            "mapping": {
              "and": "#/$defs/StoreBoolean",
              "not": "#/$defs/StoreNot",
              "or": "#/$defs/StoreBoolean",
              "store_in": "#/$defs/StoreSelection"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StoreSelection"
            },
            {
              "$ref": "#/$defs/StoreBoolean"
            },
            {
              "$ref": "#/$defs/StoreNot"
            }
          ],
          "title": "Expression"
        }
      },
      "required": [
        "semantic_dataset_version_id",
        "expression"
      ],
      "title": "StoreFilterV1",
      "type": "object"
    },
    "StoreNot": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "not",
          "default": "not",
          "title": "Kind",
          "type": "string"
        },
        "child": {
          "discriminator": {
            "mapping": {
              "and": "#/$defs/StoreBoolean",
              "not": "#/$defs/StoreNot",
              "or": "#/$defs/StoreBoolean",
              "store_in": "#/$defs/StoreSelection"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StoreSelection"
            },
            {
              "$ref": "#/$defs/StoreBoolean"
            },
            {
              "$ref": "#/$defs/StoreNot"
            }
          ],
          "title": "Child"
        }
      },
      "required": [
        "child"
      ],
      "title": "StoreNot",
      "type": "object"
    },
    "StoreSelection": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "store_in",
          "default": "store_in",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "const": "Store.store_id",
          "default": "Store.store_id",
          "title": "Field",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "StoreSelection",
      "type": "object"
    },
    "WorkspaceScopeInput": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "workspace-scope/v1",
          "default": "workspace-scope/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "dependency_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Hash",
          "type": "string"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/StoreFilterV1"
          },
          "title": "Filters",
          "type": "array"
        }
      },
      "required": [
        "dependency_hash",
        "filters"
      ],
      "title": "WorkspaceScopeInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceScopeInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "semantic_dataset_version_id": {
      "format": "uuid",
      "title": "Semantic Dataset Version Id",
      "type": "string"
    },
    "common": {
      "$ref": "#/$defs/QueryContext"
    },
    "local_store_ids": {
      "anyOf": [
        {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 1000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Local Store Ids"
    },
    "grain": {
      "enum": [
        "day",
        "week",
        "month",
        "quarter",
        "half_year",
        "year"
      ],
      "title": "Grain",
      "type": "string"
    },
    "calendar_ref": {
      "$ref": "#/$defs/CalendarRef"
    },
    "calendar_basis": {
      "enum": [
        "calendar",
        "fiscal"
      ],
      "title": "Calendar Basis",
      "type": "string"
    },
    "alignment": {
      "enum": [
        "none",
        "previous_year_same_dates"
      ],
      "title": "Alignment",
      "type": "string"
    },
    "metric_refs": {
      "items": {
        "$ref": "#/$defs/MetricRef"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Metric Refs",
      "type": "array"
    }
  },
  "required": [
    "semantic_dataset_version_id",
    "common",
    "local_store_ids",
    "grain",
    "calendar_ref",
    "calendar_basis",
    "alignment",
    "metric_refs"
  ],
  "title": "WorkspaceRunRequest",
  "type": "object"
}
