{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/critical-journey-proof.schema.json",
  "title": "Computed critical journey design proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "generated_by", "program_id", "program_revision", "program_input", "program_core_sha256", "journey_definition", "coverage", "accepted_screen_receipts", "accepted_wave_receipts", "proof_boundary", "result", "blockers"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-critical-journey-proof/v1"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version", "command"],
      "properties": {
        "script": {"const": "assemble_critical_journey_proof.py"},
        "version": {"const": "1.0.0"},
        "command": {"const": "assemble_critical_journey_proof.py <paths-redacted>"}
      }
    },
    "program_id": {"type": "string", "minLength": 1},
    "program_revision": {"type": "integer", "minimum": 1},
    "program_input": {"$ref": "#/$defs/evidenceRef"},
    "program_core_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "journey_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_id", "path", "sha256", "json_pointer"],
      "properties": {
        "journey_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "json_pointer": {"type": "string", "pattern": "^/"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_screen_ids", "required_screen_state_ids", "accepted_screen_state_ids", "declared_transition_ids", "verified_transition_ids"],
      "properties": {
        "declared_screen_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_screen_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "accepted_screen_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "declared_transition_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "verified_transition_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "accepted_screen_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screen_revision_id", "screen_id", "state_id", "path", "sha256", "result"],
        "properties": {
          "screen_revision_id": {"type": "string", "minLength": 1},
          "screen_id": {"type": "string", "minLength": 1},
          "state_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"const": "passed"}
        }
      }
    },
    "accepted_wave_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wave_id", "path", "sha256", "result"],
        "properties": {
          "wave_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"const": "passed"}
        }
      }
    },
    "proof_boundary": {"const": "critical_journey_design_evidence_not_runtime_e2e"},
    "result": {"enum": ["passed", "blocked"]},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
