      "python3 scripts/assemble_stage_transition.py --request <stage-transition-request.json> --project-root <root> --ledger <stage-ledger> --output <transition-receipt>"
    ],
    "required_validators": [
      "python3 scripts/validate_ui_design_program.py --profile structure_gate --project-root <root> <program>",
      "python3 scripts/validate_stage_ledger.py --project-root <root> <stage-ledger>",
