      "owner-decision-request.template.json",
      "proposal-for-owner-review.template.md",
      "stage-transition-request.template.json",
      "stage-transition-request.schema.json",
      "stage-transition-readiness.template.json",
      "stage-transition-readiness.schema.json"
    ],
    "required_commands": [
      "python3 scripts/ui_design_tool.py preflight",
      "python3 scripts/ui_design_tool.py capture -- --url <loopback-url> --contract <screen-contract> --anchor-id <anchor-id> --target <reference|implementation> --source-artifact <rendered-source-artifact> --logical-artifact-id <logical-id> --output <geometry-receipt> --screenshot <redacted-png>",
      "python3 scripts/assemble_render_provenance.py --request <render-provenance-request.json> --project-root <root> --output <render-provenance-receipt>",
      "python3 scripts/ui_design_tool.py compare -- --reference <reference-png> --implementation <implementation-png> --output <raster-receipt> --screen-revision-id <screen-revision-id> --anchor-id <anchor-id> --comparison-purpose <purpose> --reference-logical-artifact-id <reference-id> --implementation-logical-artifact-id <implementation-id> --visual-authority-ref <authority-path> --visual-authority-sha256 <authority-sha256> --reference-render-provenance <reference-render-provenance> --implementation-render-provenance <implementation-render-provenance> --project-root <root>",
      "python3 scripts/assemble_owner_decision.py --request <owner-decision-request.json> --project-root <root> --output <owner-decision>",
      "python3 scripts/assemble_stage_transition.py --request <stage-transition-request.json> --project-root <root> --ledger <stage-ledger> --output <transition-receipt>"
    ],
    "required_validators": [
