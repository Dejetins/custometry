{
  "schema_id": "codex.ui-stage-runtime-profiles/v1",
  "gate": "G3",
  "core": {
    "contract_registry": "assets/contract-versions.json",
    "control_plane": [
      "plan_doc",
      "prompt_pack_dir",
      "stage_ledger"
    ],
    "control_assets": [
      "stage-preflight-evidence.template.json",
      "stage-preflight-evidence.schema.json",
      "owner-input-response.template.json",
      "owner-input-response.schema.json",
      "owner-input-response-request.schema.json",
      "change-impact-matrix.json",
      "change-impact-matrix.schema.json",
      "change-record.template.json",
      "change-record.schema.json",
      "change-impact-request.schema.json",
      "change-impact-receipt.schema.json",
      "historical-control-plane-migration-request.schema.json",
      "historical-control-plane-successor-topology.schema.json",
      "historical-control-plane-migration-receipt.schema.json",
      "stage-context-manifest.schema.json"
    ],
    "control_commands": [
      "python3 scripts/ui_program_context.py --ledger <stage-ledger> --project-root <root>",
      "python3 scripts/assemble_owner_input_response.py --request <owner-response-request.json> --project-root <root> --ledger <stage-ledger> --output <owner-response>",
      "python3 scripts/assemble_change_impact.py --request <change-impact-request.json> --project-root <root> --ledger <stage-ledger> --output <impact-receipt>",
      "python3 scripts/apply_stage_ledger_update.py --project-root <root> --ledger <stage-ledger> --candidate-ledger <candidate-ledger> --expected-ledger-sha256 <sha256>",
      "python3 scripts/migrate_historical_control_plane.py prepare --request <migration-request.json> --project-root <root> --ledger <stage-ledger> --output-dir <migration-evidence-dir>",
      "python3 scripts/migrate_historical_control_plane.py apply --receipt <migration-receipt.json> --project-root <root> --ledger <stage-ledger> --candidate-ledger <candidate-ledger>"
    ],
    "input_contracts": [
      "ui-program-intake",
      "platform-ui-baseline"
    ],
    "visual_authority_fields": [
      "source_visual_ref",
      "source_visual_sha256",
      "source_evidence_mode",
      "owner_decision_ref",
      "screen_acceptance_scope",
      "visual_language_scope",
      "reusable_foundation_scope",
      "inheritance_policy",
      "mobile_scope"
    ],
    "decision_classes": {
      "agent_decidable": "Resolve reversible technical and presentation choices inside the accepted product and visual envelope; generate paths, hashes, receipts, ledgers, and routine writes without asking the user.",
      "owner_required": "Ask only for missing product meaning or scope, new mobile scope, materially different visual direction, irreversible or costly choices, and acceptance or correction of a finished visual result.",
      "external_authority": "Use an already-authorized repository route; hard-block only when a required permission or external state is genuinely unavailable."
    },
    "user_role_policy": [
      "The user's initial brief and later corrections are the sole authority for desired product meaning; repository sources are current-state evidence, not a second product owner.",
      "The user describes the desired product path once with the agent; the agent records and carries that durable intent baseline through the program.",
      "The user reviews finished visuals and corrects material product or visual mistakes.",
      "Never ask the user to calculate hashes, name technical artifact owners, edit JSON, operate the ledger, choose routine tools, or repeat ordinary write permission already granted by the task.",
      "The agent records natural-language decisions as canonical receipts and owns routine program coordination."
    ],
    "owner_surface": [
      "Lead with the stage's declared owner surface; use finished visuals or one compact review board only for G3-G6.",
      "Show material exceptions and at most three questions.",
      "Keep raw JSON, inventories, hashes, permissions, and validator logs in linked evidence.",
      "Accept unambiguous natural-language decisions; never require identifiers or magic syntax."
    ],
    "invariants": [
      "A component catalog never substitutes for the all-screen atlas.",
      "Desired product semantics come from the initial user brief and later user corrections; current product sources constrain factual compatibility but cannot silently redefine intent.",
      "Generated views and passing receipts are assembled by scripts, not hand-edited.",
      "Agent self-acceptance is prohibited; machine review readiness and user acceptance are separate states.",
      "Responsive Web is required; mobile-specific product scope requires explicit current user authorization.",
      "Current-gate success alone never permits the adjacent stage.",
      "Historical contract profiles are read-only and cannot close active gates.",
      "Determinism, source fidelity, native-image comparison, and visual-language conformance are separate claims.",
      "The accepted pilot is normative for every applicable reusable UI clause; novel target semantics, content, data, actions, and screen-specific composition remain target-owned.",
      "Applicability is independently derived and every clause application exact-covers conforms, accepted_exception, or source_backed_not_applicable; candidate-to-self comparison is never standard proof."
    ],
    "preflight_checks": [
      "current_gate",
      "source_freshness",
      "next_stage_inputs",
      "write_scope",
      "foreign_changes",
      "execution_route",
      "handoff_artifact"
    ],
    "state_policy": {
      "review_ready": "Machine evidence is complete and the finished result may be shown to the user; the stage remains non-terminal until the user accepts or requests a bounded revision.",
      "needs_input": "Ledger-only non-terminal state for a material product question or finished-result review; resume the same row from typed owner-response evidence.",
      "blocked": "Terminal only for authority, safety, evidence, permission, inseparable foreign change, or unavailable external state.",
      "revision": "Create a replacement only when target, scope, dependencies, accepted sources, prompt requirements, or acceptance criteria materially change."
    }
  },
  "stage": {
    "title": "Foundations, shell, and responsive Web",
    "artifact_kind": "program",
    "validation_profile": "program_ready",
    "objective": "Realize and prove the fixed foundations, complete typography, reusable components/states, shell/layout and responsive clauses using the declared evidence mode.",
    "owns": [
      "baseline realization",
      "representative shell screen contract",
      "responsive-Web evidence",
      "anchor binding",
      "reversible implementation decisions"
    ],
    "required_outputs": [
      "program-ready manifest",
      "candidate artifact",
      "active representative shell screen contract created and validated before capture",
      "mode-correct source evidence",
      "candidate captures",
      "compact standard board covering foundations, typography, components/states, shell/layout and responsive behavior",
      "review board",
      "clause-exact inheritance report"
    ],
    "allowed_unresolved": [],
    "forbidden": [
      "guessed range",
      "unauthorized mobile composition",
      "prose-only proof",
      "unrelated foundation",
      "fake source-fidelity claim"
    ],
    "required_references": [
      "references/responsive-policy-v1.md",
      "references/visual-provenance-contract-v1.md"
    ],
    "read_set": {
      "always": [
        "current ledger row",
        "visual-authority block"
      ],
      "exact": [
        "full platform baseline",
        "G3 rendered-proof section",
        "family shard index",
        "representative shell source slice"
      ],
      "conditional": [
        "source adapter contract selected by source_evidence_mode"
      ],
      "max_files": 16,
      "target_tokens": 600000
    },
    "required_assets": [
      "screen-design-contract.template.json",
      "screen-design-contract.schema.json",
      "render-provenance-request.template.json",
      "render-provenance-request.schema.json",
      "render-provenance-receipt.template.json",
      "render-provenance-receipt.schema.json",
      "review-board-manifest.schema.json",
