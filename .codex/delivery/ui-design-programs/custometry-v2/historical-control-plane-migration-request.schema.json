{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/historical-control-plane-migration-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "change_id", "change_kind", "owner_input", "source", "target_registry", "anchor_stage_instance_id", "successor_topology_ref", "successor_topology_sha256"],
  "properties": {
    "$schema": {"type": "string"},
    "migration_class": {"enum": ["historical_contract_upgrade", "active_semantic_compatibility"]},
    "program_id": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "minLength": 1},
    "change_kind": {"enum": ["baseline_or_visual_authority_replacement", "g3_realization_inside_accepted_baseline"]},
    "owner_input": {"type": "string", "minLength": 1},
    "anchor_stage_instance_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_ref", "ledger_sha256", "plan_doc_ref", "plan_doc_sha256", "prompt_pack_dir", "contract_registry_ref", "contract_registry_sha256"],
      "properties": {
        "ledger_ref": {"type": "string", "minLength": 1},
        "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_doc_ref": {"type": "string", "minLength": 1},
        "plan_doc_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_pack_dir": {"type": "string", "minLength": 1},
        "contract_registry_ref": {"type": "string", "minLength": 1},
        "contract_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "target_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "successor_topology_ref": {"type": "string", "minLength": 1},
    "successor_topology_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_validation_errors_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "successor_plan_doc_ref": {"type": "string", "minLength": 1},
    "successor_plan_doc_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "successor_plan_target_ref": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"migration_class": {"const": "historical_contract_upgrade"}}, "required": ["migration_class"]},
      "then": {"properties": {"change_kind": {"const": "baseline_or_visual_authority_replacement"}}}
    },
    {
      "if": {"properties": {"migration_class": {"const": "active_semantic_compatibility"}}, "required": ["migration_class"]},
      "then": {
        "required": ["source_validation_errors_sha256", "successor_plan_doc_ref", "successor_plan_doc_sha256", "successor_plan_target_ref"],
        "properties": {"change_kind": {"const": "g3_realization_inside_accepted_baseline"}}
      }
    }
  ]
}
