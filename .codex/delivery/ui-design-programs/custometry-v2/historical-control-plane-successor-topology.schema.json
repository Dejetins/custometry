{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/historical-control-plane-successor-topology.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "program_id", "source_ledger_sha256", "target_registry_sha256", "ledger_status", "current_stage", "successor_rows"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-historical-control-plane-successor-topology/v1"},
    "program_id": {"type": "string", "minLength": 1},
    "source_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_status": {"const": "active"},
    "current_stage": {"type": "string", "minLength": 1},
    "successor_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_instance_id", "gate", "target_id", "prompt_ref", "status", "dependencies", "execution_allowed", "supersedes_stage"],
        "properties": {
          "stage_instance_id": {"type": "string", "minLength": 1},
          "gate": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]},
          "target_id": {"type": "string", "minLength": 1},
          "prompt_ref": {"type": "string", "minLength": 1},
          "status": {"const": "pending"},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "execution_allowed": {"type": "boolean"},
          "supersedes_stage": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
