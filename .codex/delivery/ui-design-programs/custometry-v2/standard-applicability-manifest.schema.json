{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/standard-applicability-manifest.schema.json",
  "title": "Deterministically derived screen-to-standard applicability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "generated_by", "manifest_id", "screen_revision_id",
    "screen_identity_sha256", "baseline", "standard_revision_id",
    "clause_inventory_sha256", "entries"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-standard-applicability-manifest/v1"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version", "command"],
      "properties": {
        "script": {"const": "assemble_standard_applicability.py"},
        "version": {"const": "1.0.0"},
        "command": {"const": "assemble_standard_applicability.py <paths-redacted>"}
      }
    },
    "manifest_id": {"type": "string", "minLength": 1},
    "screen_revision_id": {"type": "string", "minLength": 1},
    "screen_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {"$ref": "#/$defs/baselineRef"},
    "standard_revision_id": {"type": "string", "minLength": 1},
    "clause_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "baselineRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "path", "sha256"],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_id", "target_kind", "target_id", "locator", "anchor_id"],
      "properties": {
        "application_id": {"type": "string", "minLength": 1},
        "target_kind": {"enum": ["element", "region", "anchor", "interaction"]},
        "target_id": {"type": "string", "minLength": 1},
        "locator": {"type": ["string", "null"]},
        "anchor_id": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "disposition", "targets", "reason_ref"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["applicable", "source_backed_not_applicable"]},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "reason_ref": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "applicable"}}},
          "then": {"properties": {"targets": {"minItems": 1}, "reason_ref": {"type": "null"}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "source_backed_not_applicable"}}},
          "then": {"properties": {"targets": {"maxItems": 0}, "reason_ref": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  }
}
