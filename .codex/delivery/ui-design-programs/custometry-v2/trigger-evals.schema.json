{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/trigger-evals.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-design-program-trigger-evals/v1"},
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "category", "prompt", "expected_route", "expected_behavior", "rationale"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["direct", "indirect", "incomplete", "should_not_trigger", "edge"]},
          "prompt": {"type": "string", "minLength": 1},
          "expected_route": {
            "enum": [
              "ui-design-program",
              "clarify_then_ui-design-program",
              "other_skill",
              "unsupported_capability",
              "ui-ux-pro-max",
              "product-design:ideate",
              "product-design:image-to-code",
              "product-design:url-to-code",
              "product-design:design-qa",
              "browser-qa-evidence",
              "better-layout",
              "better-ui"
            ]
          },
          "expected_behavior": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
