{
  "$schema": "ui-design-program.schema.json",
  "schema_id": "codex.ui-design-program/v1",
  "contract_profile": "codex.ui-design-program/v1@2.0.0",
  "program_id": "<program-id>",
  "program_name": "<program-name>",
  "revision": 1,
  "status": "draft",
  "validation_profile": "draft",
  "input_contracts": {
    "intake": {"path": "<ui-program-intake-path>", "sha256": "<ui-program-intake-sha256>"},
    "baseline": {"path": "<platform-ui-baseline-path>", "sha256": "<platform-ui-baseline-sha256>"}
  },
  "source_contracts": [],
  "visual_authority": {
    "source_visual_ref": "<accepted-pilot-path>",
    "source_visual_sha256": "<accepted-pilot-sha256>",
    "source_evidence_mode": "renderable_html",
    "owner_decision_ref": "<accepted-pilot-owner-decision>",
    "screen_acceptance_scope": "<exact-screen-acceptance-scope>",
    "visual_language_scope": "<exact-visual-language-scope>",
    "reusable_foundation_scope": "<exact-foundation-scope>",
    "inheritance_policy": "required",
    "mobile_scope": "unauthorized",
    "product_semantics_scope": "source_registry_only"
  },
  "scope": {
    "product": "<product>",
    "platform": "web",
    "included_release_slices": [],
    "excluded_release_slices": [],
    "origin": {"kind": "owner_decision", "ref": "<exact-program-scope-decision>"}
  },
  "expected_inventory": {
    "total": 0,
    "route_screens": 0,
    "route_flows": 0,
    "persistent_shells": 0,
    "route_backed_transients": 0,
    "overlays": 0,
    "system_state_families": 0,
    "internal_or_non_visual": 0,
    "historical_exclusions": 0,
    "journeys": 0
  },
  "screens": [],
  "journeys": [],
  "coverage_profiles": [],
  "families": [],
  "waves": [],
  "g6_handoff": null,
  "gates": [
    {"gate_id": "G0", "title": "Authoritative sources", "owner_decision_required": false},
    {"gate_id": "G1", "title": "Complete screen atlas", "owner_decision_required": false},
    {"gate_id": "G2", "title": "Journeys, families, and waves", "owner_decision_required": false},
    {"gate_id": "G3", "title": "Foundations and application shell", "owner_decision_required": true},
    {"gate_id": "G4", "title": "Representative family", "owner_decision_required": true},
    {"gate_id": "G5", "title": "Screen wave", "owner_decision_required": true},
    {"gate_id": "G6", "title": "Cross-program QA and implementation handoff", "owner_decision_required": true}
  ],
  "responsive_policy": {
    "adaptive_web_required": true,
    "supported_web_width_range": {
      "min_width": null,
      "max_width": null,
      "origin": {"kind": "owner_decision", "ref": "<exact-range-decision>"}
    },
    "anchor_viewports": [],
    "breakpoint_policy": "content_driven",
    "breakpoint_policy_origin": {"kind": "normative_requirement", "ref": "references/responsive-policy-v1.md#breakpoints-and-components"},
    "component_adaptation": "prefer_container_queries",
    "component_adaptation_origin": {"kind": "normative_requirement", "ref": "references/responsive-policy-v1.md#breakpoints-and-components"},
    "logical_properties_required": true,
    "logical_properties_origin": {"kind": "normative_requirement", "ref": "references/responsive-policy-v1.md#breakpoints-and-components"},
    "mobile_scope": "unauthorized",
    "mobile_scope_origin": {"kind": "normative_requirement", "ref": "references/responsive-policy-v1.md#mobile-authorization-boundary"},
    "mobile_authorization_ref": null,
    "authorized_mobile_surfaces": [],
    "authorized_mobile_viewports": [],
    "allowed_mobile_changes": []
  },
  "invention_policy": {
    "default": "forbidden",
    "unknown_value": "classify_then_resolve_or_escalate",
    "implicit_screen_addition": "forbidden",
    "implicit_state_removal": "forbidden",
    "unsourced_visual_value": "forbidden",
    "agent_self_acceptance": "forbidden"
  },
  "program_acceptance": {
    "agent_self_acceptance": "prohibited",
    "owner_decision_ref": null,
    "accepted_revision": null
  },
  "execution_artifacts": {
    "plan_doc": "<plan-doc>",
    "prompt_pack_dir": "<prompt-pack-dir>",
    "stage_ledger": "<stage-ledger>"
  }
}
