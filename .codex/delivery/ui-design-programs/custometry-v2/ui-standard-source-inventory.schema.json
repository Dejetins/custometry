{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/ui-standard-source-inventory.schema.json",
  "title": "Pilot-derived reusable UI source observation inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "contract_profile", "inventory_id", "revision",
    "source_visual", "generated_by", "property_set_id", "capture_receipt",
    "visible_nodes", "observations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-standard-source-inventory/v1"},
    "contract_profile": {"const": "codex.ui-standard-source-inventory/v1@2.0.0"},
    "inventory_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "source_visual": {"$ref": "#/$defs/evidenceRef"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version", "command"],
      "properties": {
        "script": {"const": "capture_ui_standard.cjs"},
        "version": {"const": "2.0.0"},
        "command": {"const": "capture_ui_standard.cjs <paths-redacted>"}
      }
    },
    "property_set_id": {"const": "codex.reusable-ui-properties/v1"},
    "capture_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_id", "viewport", "main_document_response_sha256", "visible_node_count", "visible_node_inventory_sha256", "observation_count", "observation_ids_sha256", "measurements_sha256"],
      "properties": {
        "anchor_id": {"type": "string", "minLength": 1},
        "viewport": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
        "main_document_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "visible_node_count": {"type": "integer", "minimum": 1},
        "visible_node_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observation_count": {"type": "integer", "minimum": 1},
        "observation_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "measurements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "visible_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visibleNode"}},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "visibleNode": {
      "type": "object", "additionalProperties": false,
      "required": ["locator", "identity", "reuse_expectation"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "identity": {"$ref": "#/$defs/identity"},
        "reuse_expectation": {"enum": ["reusable_required", "disposition_required"]}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope", "component_id", "variant", "size_class", "slot_id",
        "state_id", "shell_region_id", "icon_id", "element_type", "anchor_id"
      ],
      "properties": {
        "scope": {"enum": ["component", "shell_region", "icon", "interaction", "responsive", "foundation"]},
        "component_id": {"type": ["string", "null"]},
        "variant": {"type": ["string", "null"]},
        "size_class": {"type": ["string", "null"]},
        "slot_id": {"type": ["string", "null"]},
        "state_id": {"type": ["string", "null"]},
        "shell_region_id": {"type": ["string", "null"]},
        "icon_id": {"type": ["string", "null"]},
        "element_type": {"type": ["string", "null"]},
        "anchor_id": {"type": ["string", "null"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id", "domain", "property", "value", "unit", "locator",
        "identity", "reuse_expectation", "source_ref", "measurement_sha256"
      ],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "domain": {"enum": ["typography", "control", "color", "border", "elevation", "opacity", "component", "icon", "focus", "motion", "shell", "layout", "responsive", "interaction", "spacing", "radius", "sizing"]},
        "property": {"type": "string", "minLength": 1},
        "value": {},
        "unit": {"type": ["string", "null"]},
        "locator": {"type": "string", "minLength": 1},
        "identity": {"$ref": "#/$defs/identity"},
        "reuse_expectation": {"enum": ["reusable_required", "disposition_required"]},
        "source_ref": {"type": "string", "minLength": 1},
        "measurement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
