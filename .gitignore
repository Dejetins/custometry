# System Design is maintained in Markdown; presentation exports are ephemeral.
/docs/architecture/*system-design*.docx

# Local drafts for future private distribution/activation work. This prevents
# accidental commits only; authoritative private material belongs in separate
# access-controlled storage, never in this public repository.
/.private/

# Codex machine-local state; durable prompt packs remain tracked
.codex/agents/.context/
.codex/tmp/
.codex/sessions/
.codex/**/*.local.*

# Retired G-program output is recoverable from Git, not an active artifact route.
/.codex/delivery/ui-design-programs/custometry-v1/
/.codex/delivery/ui-design-programs/custometry-v2/
/.codex/agents/generated/custometry-ui-design-g0-v2/
/.codex/agents/generated/custometry-ui-design-g4-v1/
