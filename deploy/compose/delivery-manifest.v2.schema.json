            },
            "anonymous_allowed": {
              "const": false
            },
            "images_may_be_public": {
              "const": true
            },
            "fallback": {
              "const": "none"
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "archive",
            "verify_before_execution",
            "remote_schema_refs",
            "symlinks",
            "hardlinks",
            "duplicate_entries",
            "case_collisions",
            "unknown_files"
          ],
          "properties": {
            "archive": {
              "const": "zip-stored-or-deflated-regular-files-only"
            },
            "verify_before_execution": {
              "const": true
            },
            "remote_schema_refs": {
              "const": false
            },
            "symlinks": {
              "const": false
            },
            "hardlinks": {
              "const": false
            },
            "duplicate_entries": {
              "const": false
            },
            "case_collisions": {
              "const": false
            },
            "unknown_files": {
              "const": false
