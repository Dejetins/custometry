        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "url",
              "sha256"
            ],
            "properties": {
              "name": {
                "enum": [
                  "cosign",
                  "trivy",
                  "syft"
