{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custometry internal delivery manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_version",
    "application_version",
    "channel",
    "source",
    "producer",
    "capabilities",
    "profiles",
    "images",
    "services",
    "files",
    "resources",
    "compatibility",
    "migrations",
    "build_inputs",
    "evidence",
    "resources_budget",
    "retrieval",
    "signature",
    "companions"
  ],
  "properties": {
    "schema_version": {
      "const": "custometry-delivery/v2"
    },
    "delivery_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "application_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "channel": {
      "const": "internal-candidate"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/Dejetins/custometry"
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "ref",
        "run_id",
        "run_attempt"
      ],
      "properties": {
        "workflow": {
          "const": ".github/workflows/publish-candidates.yml"
        },
        "ref": {
          "const": "refs/heads/main"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "services",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "status": {
            "enum": [
              "enabled",
              "unavailable",
              "deferred"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "enum": [
                "api",
                "web",
                "edge",
                "control-db",
                "migrate",
                "demo-source-db"
              ]
            },
            "minItems": 0,
            "maxItems": 6,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "core",
          "migration",
          "demo"
        ]
      },
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "web",
        "postgres"
      ],
      "properties": {
        "api": {
          "$ref": "#/$defs/image"
        },
        "web": {
          "$ref": "#/$defs/image"
        },
        "postgres": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      },
      "minItems": 5,
      "maxItems": 6,
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader_major",
        "configuration_schema",
        "docker_api_min",
        "compose_min",
        "tested_engines",
        "postgres_version",
        "supported_platforms"
      ],
      "properties": {
        "reader_major": {
          "const": 2
        },
        "configuration_schema": {
          "const": "custometry-compose/v1"
        },
        "docker_api_min": {
          "const": "1.43"
        },
        "compose_min": {
          "const": "2.24.4"
        },
        "tested_engines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "engine_version",
              "compose_version",
              "host_os",
              "host_arch"
            ],
            "properties": {
              "engine_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "compose_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "host_os": {
                "enum": [
                  "linux",
                  "darwin"
                ]
              },
              "host_arch": {
                "enum": [
                  "arm64",
                  "amd64"
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "postgres_version": {
          "const": "17.11"
        },
        "supported_platforms": {
          "const": [
            "linux/amd64",
            "linux/arm64"
          ]
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "revisions",
        "support_files",
        "starting_state",
        "read_head",
        "write_head",
        "command",
        "downtime",
        "rollback",
        "artifact_format_compatibility"
      ],
      "properties": {
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9_]+$"
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "support_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "starting_state": {
          "const": "fresh-owned-database"
        },
        "read_head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9_]+$"
        },
        "write_head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9_]+$"
        },
        "command": {
          "const": [
            "alembic",
            "-c",
            "/app/migrations/alembic.ini",
            "upgrade",
            "head"
          ]
        },
        "downtime": {
          "const": "before-application-start"
        },
        "rollback": {
          "const": "not-qualified"
        },
        "artifact_format_compatibility": {
          "const": "not-qualified"
        }
      }
    },
    "build_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)[.]{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_.][A-Za-z0-9_.-]*)*$"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 16384,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "resources_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ram_bytes",
        "owned_disk_bytes",
        "api_unpacked_max_bytes",
        "web_unpacked_max_bytes"
      ],
      "properties": {
        "ram_bytes": {
          "const": 6442450944
        },
        "owned_disk_bytes": {
          "const": 26843545600
        },
        "api_unpacked_max_bytes": {
          "const": 367001600
        },
        "web_unpacked_max_bytes": {
          "const": 104857600
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "artifact_name",
        "retention_days"
      ],
      "properties": {
        "provider": {
          "const": "github-actions-artifact"
        },
        "repository": {
          "const": "Dejetins/custometry"
        },
        "artifact_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^custometry-delivery-[A-Za-z0-9.+_-]+$"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "subject"
      ],
      "properties": {
        "format": {
          "const": "sigstore-bundle"
        },
        "path": {
          "const": "delivery-manifest.sigstore.json"
        },
        "subject": {
          "const": "canonical-manifest-bytes"
        }
      }
    },
    "companions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "artifact_name",
          "artifact_id",
          "provider_sha256",
          "archive_bytes",
          "expanded_bytes",
          "expires_at",
          "files"
        ],
        "properties": {
          "part": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "artifact_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^custometry-delivery-sources-[A-Za-z0-9.+_-]+-[0-9]{2}$"
          },
          "artifact_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "provider_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "archive_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "expanded_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "expires_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 32,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]{1,6})?Z$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^(?!.*(?:^|/)[.]{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_.][A-Za-z0-9_.-]*)*$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 268435456
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!.*(?:^|/)[.]{1,2}(?:/|$))[A-Za-z0-9_.][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_.][A-Za-z0-9_.-]*)*$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "role": {
          "enum": [
            "compose",
            "config",
            "resource",
            "verifier",
            "notices",
            "evidence",
            "legacy-env",
            "migration",
            "asset",
            "toolchain"
          ]
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "digest",
        "compressed_bytes",
        "unpacked_bytes"
      ],
      "properties": {
        "os": {
          "const": "linux"
        },
        "architecture": {
          "enum": [
            "arm64",
            "amd64"
          ]
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compressed_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "unpacked_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "index_digest",
        "platforms",
        "embedded_files"
      ],
      "properties": {
        "repository": {
          "enum": [
            "ghcr.io/dejetins/custometry-api",
            "ghcr.io/dejetins/custometry-web",
            "docker.io/library/postgres"
          ]
        },
        "index_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platform"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "embedded_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 0,
          "maxItems": 16384,
          "uniqueItems": true
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "image",
        "profile",
        "depends_on"
      ],
      "properties": {
        "name": {
          "enum": [
            "control-db",
            "api",
            "web",
            "edge",
            "migrate",
            "demo-source-db"
          ]
        },
        "image": {
          "enum": [
            "api",
            "web",
            "postgres"
          ]
        },
        "profile": {
          "enum": [
            "core",
            "migration",
            "demo"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "enum": [
              "control-db",
              "api",
              "web"
            ]
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "location",
        "services",
        "profile",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "bundle-file",
            "image-file",
            "secret-slot",
            "volume",
            "tmpfs",
            "network"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "services": {
          "type": "array",
          "items": {
            "enum": [
              "control-db",
              "api",
              "web",
              "edge",
              "migrate",
              "demo-source-db"
            ]
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "profile": {
          "enum": [
            "core",
            "migration",
            "demo"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "down_revision",
        "file"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9_]+$"
        },
        "down_revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-z0-9_]+$"
            }
          ]
        },
        "file": {
          "$ref": "#/$defs/file"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "file"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sbom",
            "licenses",
            "vulnerabilities",
            "provenance",
            "rebuild-comparison"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "file": {
          "$ref": "#/$defs/file"
        }
      }
    },
    "verificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "reader_major",
        "manifest_schema",
        "canonicalization",
        "origin",
        "signer",
        "limits",
        "retrieval",
        "verification",
        "scanner",
        "tools",
        "actions",
        "dockerfile_frontend",
        "companions"
      ],
      "properties": {
        "policy_version": {
          "const": "custometry-delivery-policy/v2"
        },
        "reader_major": {
          "const": 2
        },
        "manifest_schema": {
          "const": "custometry-delivery/v2"
        },
        "canonicalization": {
          "const": "ascii-sorted-compact-json-no-newline/v1"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "api",
            "workflow",
            "ref",
            "image_repositories",
            "redirect_suffixes"
          ],
          "properties": {
            "repository": {
              "const": "Dejetins/custometry"
            },
            "api": {
              "const": "https://api.github.com"
            },
            "workflow": {
              "const": ".github/workflows/publish-candidates.yml"
            },
            "ref": {
              "const": "refs/heads/main"
            },
            "image_repositories": {
              "const": [
                "ghcr.io/dejetins/custometry-api",
                "ghcr.io/dejetins/custometry-web",
                "docker.io/library/postgres"
              ]
            },
            "redirect_suffixes": {
              "const": [
                ".blob.core.windows.net",
                ".actions.githubusercontent.com"
              ]
            }
          }
        },
        "signer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "issuer",
            "require_transparency_log",
            "allow_identity_regexp"
          ],
          "properties": {
            "identity": {
              "const": "https://github.com/Dejetins/custometry/.github/workflows/publish-candidates.yml@refs/heads/main"
            },
            "issuer": {
              "const": "https://token.actions.githubusercontent.com"
            },
            "require_transparency_log": {
              "const": true
            },
            "allow_identity_regexp": {
              "const": false
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_bytes",
            "policy_bytes",
            "json_depth",
            "archive_bytes",
            "expanded_bytes",
            "file_bytes",
            "entries",
            "compression_ratio",
            "path_bytes",
            "redirects",
            "timeout_seconds"
          ],
          "properties": {
            "manifest_bytes": {
              "const": 1048576
            },
            "policy_bytes": {
              "const": 65536
            },
            "json_depth": {
              "const": 32
            },
            "archive_bytes": {
              "const": 134217728
            },
            "expanded_bytes": {
              "const": 536870912
            },
            "file_bytes": {
              "const": 67108864
            },
            "entries": {
              "const": 2048
