              "const": 240
            },
            "redirects": {
              "const": 2
            },
            "timeout_seconds": {
              "const": 300
            }
          }
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "retention_days",
            "handoff_copy_required",
            "credential",
            "anonymous_allowed",
            "images_may_be_public",
            "fallback"
