# Copy only for manual Compose usage. bootstrap.sh creates .runtime.env safely.
COMPOSE_PROJECT_NAME=custometry-local-unique-name
CUSTOMETRY_BIND_HOST=127.0.0.1
CUSTOMETRY_HTTP_PORT=8080
CUSTOMETRY_VERSION=0.1.0-dev.0
CUSTOMETRY_ENVIRONMENT=development
CUSTOMETRY_SECRETS_DIR=./deploy/compose/.runtime-secrets
