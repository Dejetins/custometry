{
  "components": {
    "schemas": {
      "AnalyticsResultListResponse": {
        "additionalProperties": false,
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/AnalyticsResultResponse"
            },
            "title": "Results",
            "type": "array"
          },
          "visible_count": {
            "minimum": 0.0,
            "title": "Visible Count",
            "type": "integer"
          }
        },
        "required": [
          "results",
          "visible_count"
        ],
        "title": "AnalyticsResultListResponse",
        "type": "object"
      },
      "AnalyticsResultResponse": {
        "additionalProperties": false,
        "properties": {
          "applied_comparison_mode": {
            "title": "Applied Comparison Mode",
            "type": "string"
          },
          "calendar_version_id": {
            "format": "uuid",
            "title": "Calendar Version Id",
            "type": "string"
          },
          "comparability_status": {
            "enum": [
              "comparable",
              "partial",
              "not_comparable"
            ],
            "title": "Comparability Status",
            "type": "string"
          },
          "comparison_coverage": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comparison Coverage"
          },
          "comparison_policy_hash": {
            "title": "Comparison Policy Hash",
            "type": "string"
          },
          "current_coverage": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Current Coverage",
            "type": "object"
          },
          "freshness": {
            "additionalProperties": true,
            "title": "Freshness",
            "type": "object"
          },
          "limitation_codes": {
            "items": {
              "type": "string"
            },
            "title": "Limitation Codes",
            "type": "array"
          },
          "lineage": {
            "additionalProperties": true,
            "title": "Lineage",
            "type": "object"
          },
          "manifest": {
            "additionalProperties": true,
            "title": "Manifest",
            "type": "object"
          },
          "metric_groups": {
            "items": {
              "$ref": "#/components/schemas/MetricGroupProjection"
            },
            "title": "Metric Groups",
            "type": "array"
          },
          "normalized_filter_expression_hash": {
            "title": "Normalized Filter Expression Hash",
            "type": "string"
          },
          "policy_hash": {
            "title": "Policy Hash",
            "type": "string"
          },
          "quality": {
            "additionalProperties": true,
            "title": "Quality",
            "type": "object"
          },
          "request_hash": {
            "title": "Request Hash",
            "type": "string"
          },
          "resolved_comparison_period": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved Comparison Period"
          },
          "resolved_current_period": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Resolved Current Period",
            "type": "object"
          },
          "result_id": {
            "format": "uuid",
            "title": "Result Id",
            "type": "string"
          },
          "result_type": {
            "enum": [
              "sales",
              "customer",
              "rfm"
            ],
            "title": "Result Type",
            "type": "string"
          },
          "rfm_profiles": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Rfm Profiles",
            "type": "array"
          },
          "semantic_dataset_version_id": {
            "format": "uuid",
            "title": "Semantic Dataset Version Id",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "result_id",
          "result_type",
          "semantic_dataset_version_id",
          "request_hash",
          "policy_hash",
          "applied_comparison_mode",
          "resolved_current_period",
          "resolved_comparison_period",
          "timezone",
          "calendar_version_id",
          "comparison_policy_hash",
          "normalized_filter_expression_hash",
          "metric_groups",
          "current_coverage",
          "comparison_coverage",
          "comparability_status",
          "limitation_codes",
          "quality",
          "freshness",
          "lineage",
          "rfm_profiles",
          "manifest"
        ],
        "title": "AnalyticsResultResponse",
        "type": "object"
      },
      "AnalyticsRunRequest": {
        "additionalProperties": false,
        "properties": {
          "comparison": {
            "$ref": "#/components/schemas/TimeComparisonRequest"
          },
          "filters": {
            "items": {
              "$ref": "#/components/schemas/TypedFilterRequest"
            },
            "maxItems": 12,
            "title": "Filters",
            "type": "array"
          },
          "result_type": {
            "enum": [
              "sales",
              "customer",
              "rfm"
            ],
            "title": "Result Type",
            "type": "string"
          },
          "rfm_frequency_measure": {
            "default": "receipt_count",
            "enum": [
              "receipt_count",
              "purchase_day_count"
            ],
            "title": "Rfm Frequency Measure",
            "type": "string"
          },
          "rfm_score_bins": {
            "default": 5,
            "maximum": 10.0,
            "minimum": 2.0,
            "title": "Rfm Score Bins",
            "type": "integer"
          },
          "rfm_segment_rule_set_version": {
            "const": "rfm-retail-v1",
            "default": "rfm-retail-v1",
            "title": "Rfm Segment Rule Set Version",
            "type": "string"
          },
          "semantic_dataset_version_id": {
            "format": "uuid",
            "title": "Semantic Dataset Version Id",
            "type": "string"
          }
        },
        "required": [
          "result_type",
          "semantic_dataset_version_id",
          "comparison"
        ],
        "title": "AnalyticsRunRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MetricGroupProjection": {
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "title": "Group Id",
            "type": "string"
          },
          "group_order": {
            "title": "Group Order",
            "type": "integer"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricProjection"
            },
            "title": "Metrics",
            "type": "array"
          }
        },
        "required": [
          "group_id",
          "group_order",
          "metrics"
        ],
        "title": "MetricGroupProjection",
        "type": "object"
      },
      "MetricProjection": {
        "additionalProperties": false,
        "properties": {
          "absolute_change": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Absolute Change"
          },
          "compact_comparison": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compact Comparison"
          },
          "compact_current": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compact Current"
          },
          "comparison_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comparison Value"
          },
          "current_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Value"
          },
          "limitation_codes": {
            "items": {
              "type": "string"
            },
            "title": "Limitation Codes",
            "type": "array"
          },
          "metric_id": {
            "title": "Metric Id",
            "type": "string"
          },
          "metric_order": {
            "title": "Metric Order",
            "type": "integer"
          },
          "percent_change": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent Change"
          }
        },
        "required": [
          "metric_id",
          "metric_order",
          "current_value",
          "comparison_value",
          "absolute_change",
          "percent_change",
          "compact_current",
          "compact_comparison",
          "limitation_codes"
        ],
        "title": "MetricProjection",
        "type": "object"
      },
      "PeriodRequest": {
        "additionalProperties": false,
        "properties": {
          "ends_on": {
            "format": "date",
            "title": "Ends On",
            "type": "string"
          },
          "starts_on": {
            "format": "date",
            "title": "Starts On",
            "type": "string"
          }
        },
        "required": [
          "starts_on",
          "ends_on"
        ],
        "title": "PeriodRequest",
        "type": "object"
      },
      "TimeComparisonRequest": {
        "additionalProperties": false,
        "properties": {
          "calendar_version_id": {
            "format": "uuid",
            "title": "Calendar Version Id",
            "type": "string"
          },
          "comparison_period": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PeriodRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "current_period": {
            "$ref": "#/components/schemas/PeriodRequest"
          },
          "definition_compatibility_policy": {
            "enum": [
              "require_same_versions",
              "allow_explicit_rebase"
            ],
            "title": "Definition Compatibility Policy",
            "type": "string"
          },
          "incomplete_period_policy": {
            "enum": [
              "exclude",
              "comparable_elapsed_days",
              "explicit_partial"
            ],
            "title": "Incomplete Period Policy",
            "type": "string"
          },
          "iso_week_53_policy": {
            "enum": [
              "calendar_map",
              "exclude",
              "explicit_partial"
            ],
            "title": "Iso Week 53 Policy",
            "type": "string"
          },
          "leap_day_policy": {
            "enum": [
              "calendar_map",
              "exclude",
              "merge_with_feb_28"
            ],
            "title": "Leap Day Policy",
            "type": "string"
          },
          "mode": {
            "enum": [
              "none",
              "previous_year_same_dates",
              "previous_year_calendar_aligned",
              "previous_year_iso_week_aligned",
              "previous_year_fiscal_period",
              "previous_year_comparable_elapsed_days"
            ],
            "title": "Mode",
            "type": "string"
          },
          "timezone": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "current_period",
          "timezone",
          "calendar_version_id",
          "incomplete_period_policy",
          "leap_day_policy",
          "iso_week_53_policy",
          "definition_compatibility_policy"
        ],
        "title": "TimeComparisonRequest",
        "type": "object"
      },
      "TypedFilterRequest": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "store_id",
              "channel_id",
              "currency",
              "status",
              "net_amount"
            ],
            "title": "Field",
            "type": "string"
          },
          "operator": {
            "enum": [
              "eq",
              "in",
              "gte",
              "lte"
            ],
            "title": "Operator",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "field",
          "operator",
          "value"
        ],
        "title": "TypedFilterRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Custometry Governed Analytics API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/results": {
      "get": {
        "operationId": "list_governed_analytics_results",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResultListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Results"
      },
      "post": {
        "operationId": "run_governed_analytics",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResultResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Result"
      }
    },
    "/results/{result_id}": {
      "get": {
        "operationId": "get_governed_analytics_result",
        "parameters": [
          {
            "in": "path",
            "name": "result_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Result Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResultResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Result"
      }
    }
  }
}
