          "group_key": {
            "title": "Group Key",
            "type": "string"
          },
          "latest_event_id": {
            "format": "uuid",
            "title": "Latest Event Id",
            "type": "string"
          },
          "message_code": {
            "title": "Message Code",
            "type": "string"
