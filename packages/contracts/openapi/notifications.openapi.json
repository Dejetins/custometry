            "title": "Message Parameters",
            "type": "object"
          },
          "notification_id": {
            "format": "uuid",
            "title": "Notification Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "read": {
            "title": "Read",
            "type": "boolean"
          },
          "resolved": {
            "title": "Resolved",
            "type": "boolean"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "title": "Severity",
            "type": "string"
          },
          "source_event_count": {
            "minimum": 1.0,
            "title": "Source Event Count",
            "type": "integer"
          },
          "source_owner": {
            "title": "Source Owner",
            "type": "string"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
