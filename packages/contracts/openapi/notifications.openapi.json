        "additionalProperties": false,
        "properties": {
          "acknowledged": {
            "title": "Acknowledged",
            "type": "boolean"
          },
          "category": {
            "enum": [
              "run",
              "data_quality",
              "data_freshness",
              "forecast",
              "schedule",
              "system",
              "security",
              "admin"
            ],
            "title": "Category",
            "type": "string"
          },
          "deep_link": {
            "$ref": "#/components/schemas/DeepLinkResponse"
          },
          "dismissed": {
            "title": "Dismissed",
