          "notification_id",
          "workspace_id",
          "latest_event_id",
          "source_owner",
          "source_type",
          "severity",
          "category",
          "occurred_at",
          "message_code",
          "message_parameters",
          "group_key",
          "source_event_count",
          "trace_id",
          "resolved",
          "read",
          "dismissed",
          "acknowledged",
