          "connector_id": {
            "const": "postgresql",
            "title": "Connector Id",
            "type": "string"
          },
          "display_name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "profile_ref": {
            "maxLength": 80,
            "minLength": 3,
            "title": "Profile Ref",
            "type": "string"
          },
          "secret_ref": {
            "maxLength": 80,
            "minLength": 3,
            "title": "Secret Ref",
            "type": "string"
          }
        },
        "required": [
          "connector_id",
          "profile_ref",
          "secret_ref",
          "display_name"
        ],
        "title": "ConnectionCreateRequest",
        "type": "object"
      },
      "ConnectionResponse": {
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "format": "uuid",
            "title": "Connection Id",
            "type": "string"
          },
