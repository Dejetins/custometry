      "ExtractRequest": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Columns",
            "type": "array"
          },
          "limit": {
            "default": 1000,
            "maximum": 10000.0,
