            "type": "array"
          },
          "object_name": {
            "title": "Object Name",
            "type": "string"
          },
          "object_type": {
            "enum": [
              "table",
              "view"
            ],
            "title": "Object Type",
            "type": "string"
          },
          "schema_name": {
            "title": "Schema Name",
            "type": "string"
          }
        },
        "required": [
          "schema_name",
          "object_name",
          "object_type",
          "columns"
        ],
        "title": "CatalogObjectResponse",
        "type": "object"
      },
      "CatalogResponse": {
        "additionalProperties": false,
        "properties": {
          "objects": {
            "items": {
              "$ref": "#/components/schemas/CatalogObjectResponse"
            },
            "title": "Objects",
            "type": "array"
          }
        },
        "required": [
          "objects"
        ],
        "title": "CatalogResponse",
        "type": "object"
      },
      "CloseSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "enum": [
              "committed",
              "aborted"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "outcome"
        ],
        "title": "CloseSessionRequest",
        "type": "object"
      },
      "ConnectionCreateRequest": {
        "additionalProperties": false,
