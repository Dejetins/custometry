          "object_name": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Object Name",
            "type": "string"
          },
          "schema_name": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Schema Name",
            "type": "string"
