{
  "openapi": "3.1.0",
  "info": {
    "title": "Custometry Workspace Calendar API",
    "version": "1.0.0"
  },
  "paths": {
    "/workspace-calendar/v1": {
      "get": {
        "summary": "Default",
        "operationId": "get_workspace_calendar_v1",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceCalendarDefault"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          }
        }
      }
    },
    "/workspace-calendar/v1/versions/{version_id}": {
      "get": {
        "summary": "Version",
        "operationId": "get_workspace_calendar_version_v1",
        "parameters": [
          {
            "name": "version_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Version Id"
            }
          },
          {
            "name": "content_hash",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Content Hash"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessCalendarVersion"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/workspace-calendar/v1/versions": {
      "post": {
        "summary": "Update",
        "operationId": "update_workspace_calendar_v1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCalendarRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceCalendarDefault"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BusinessCalendarProfile": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "business-calendar/v1",
            "title": "Schema Version",
            "default": "business-calendar/v1"
          },
          "kind": {
            "type": "string",
            "const": "month_based",
            "title": "Kind",
            "default": "month_based"
          },
          "fiscal_year_start_month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Fiscal Year Start Month",
            "default": 1
          },
          "fiscal_year_start_day": {
            "type": "integer",
            "const": 1,
            "title": "Fiscal Year Start Day",
            "default": 1
          },
          "year_label": {
            "type": "string",
            "enum": [
              "start_year",
              "end_year"
            ],
            "title": "Year Label",
            "default": "end_year"
          },
          "timezone": {
            "type": "string",
            "const": "UTC",
            "title": "Timezone",
            "default": "UTC"
          },
          "week_start": {
            "type": "string",
            "const": "monday",
            "title": "Week Start",
            "default": "monday"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BusinessCalendarProfile"
      },
      "BusinessCalendarVersion": {
        "properties": {
          "version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Version Id"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Workspace Id"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Hash"
          },
          "profile": {
            "$ref": "#/components/schemas/BusinessCalendarProfile"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "previous_version_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Version Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version_id",
          "workspace_id",
          "content_hash",
          "profile",
          "created_by",
          "created_at",
          "previous_version_id"
        ],
        "title": "BusinessCalendarVersion"
      },
      "CalendarError": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "AUTHENTICATION_FAILED",
              "FORBIDDEN",
              "CSRF_FAILED",
              "NOT_FOUND",
              "CALENDAR_REVISION_CONFLICT",
              "CALENDAR_IDEMPOTENCY_CONFLICT",
              "STORAGE_UNAVAILABLE"
            ],
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CalendarError"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "UpdateCalendarRequest": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/BusinessCalendarProfile"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile",
          "expected_revision",
          "idempotency_key"
        ],
        "title": "UpdateCalendarRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspaceCalendarDefault": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Workspace Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "calendar": {
            "$ref": "#/components/schemas/BusinessCalendarVersion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "workspace_id",
          "revision",
          "calendar"
        ],
        "title": "WorkspaceCalendarDefault"
      }
    }
  }
}
