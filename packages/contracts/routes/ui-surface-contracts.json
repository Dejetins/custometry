  "route_decision_policy": {
    "route_when": [
      "durable entity or version lifecycle",
      "notification audit or bookmark deep link",
      "independent Back refresh or unsaved-change semantics",
      "independent permission boundary with complex recoverable state"
    ],
    "overlay_when": [
      "transient confirmation or contextual inspection",
      "no independent durable lifecycle",
      "return to an owning route is always required"
    ],
    "component_when": [
      "the same governed behavior is reused across several routes",
      "the behavior has no independent resource identity",
      "consistent rendering and accessibility are more important than a new URL"
    ],
    "route_count_is_ceiling": false
  },
