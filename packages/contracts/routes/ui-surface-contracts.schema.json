{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custometry.local/schemas/ui-surface-contracts-1.0.0.json",
  "title": "Custometry UI surface coverage contracts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_spec_version",
    "ui_spec_version",
    "route_contract_schema_version",
    "source_files",
    "route_decision_policy",
    "penpot_baseline",
    "overlays",
    "system_surfaces",
    "cross_surface_capabilities",
    "use_case_bindings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product_spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-draft$"},
    "ui_spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-draft$"},
    "route_contract_schema_version": {"const": "1.0.0"},
    "source_files": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "route_decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_when", "overlay_when", "component_when", "route_count_is_ceiling"],
      "properties": {
        "route_when": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "overlay_when": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "component_when": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "route_count_is_ceiling": {"const": false}
      }
    },
    "penpot_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "working_name", "observed_revision", "page_count", "verified_route_count", "target_route_count"],
      "properties": {
        "file_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "working_name": {"type": "string", "minLength": 1},
        "observed_revision": {"type": "integer", "minimum": 0},
        "page_count": {"type": "integer", "minimum": 1},
        "verified_route_count": {"type": "integer", "minimum": 0},
        "target_route_count": {"type": "integer", "minimum": 1}
      }
    },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/overlay"}
    },
    "system_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/systemSurface"}
    },
    "cross_surface_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "use_case_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/useCaseBinding"}
    }
  },
  "$defs": {
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"}
    },
    "surfaceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^UI-(?:[A-Z]+-[0-9]{3}|OVR-[0-9]{3}|SYS-[0-9]{3}|CAP-[0-9]{3})$"}
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "route_backed", "history_semantics", "requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^UI-OVR-[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["modal", "drawer", "popover", "route_surface"]},
        "route_backed": {"type": "boolean"},
        "history_semantics": {"enum": ["none", "replace", "push_return_to_origin"]},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"}
      }
    },
    "systemSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^UI-SYS-[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "delivery_form", "requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^UI-CAP-[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "delivery_form": {"enum": ["component_contract", "policy_contract", "route_state_contract"]},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"}
      }
    },
    "useCaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_case_id", "surface_ids", "coverage_types", "rationale"],
      "properties": {
        "use_case_id": {"type": "string", "pattern": "^UC-[0-9]{3}$"},
        "surface_ids": {"$ref": "#/$defs/surfaceIds"},
        "coverage_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["route", "overlay", "system", "cross_surface_capability"]}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
