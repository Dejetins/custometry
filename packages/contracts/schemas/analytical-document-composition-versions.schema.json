        "access_policy_id",
        "filter_scope_bindings",
        "definition",
        "chart_specs",
        "bindings_by_card"
      ],
      "title": "AnalyticalDocumentCompositionV2",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BaseSnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "version_id",
        "snapshot_id",
        "manifest"
      ],
      "title": "BaseSnapshotRef",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "format": "uuid",
          "title": "Block Id",
          "type": "string"
        },
        "section_id": {
          "format": "uuid",
          "title": "Section Id",
          "type": "string"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "block_type": {
          "enum": [
            "metric_group",
            "chart",
            "table",
            "result_trust"
          ],
          "title": "Block Type",
          "type": "string"
        },
        "source_binding": {
          "additionalProperties": true,
          "title": "Source Binding",
          "type": "object"
        },
        "content_binding": {
          "default": null,
          "title": "Content Binding",
          "type": "null"
        },
        "presentation": {
          "additionalProperties": true,
          "title": "Presentation",
          "type": "object"
        }
      },
      "required": [
        "block_id",
        "section_id",
        "order",
        "block_type",
        "source_binding",
        "presentation"
      ],
      "title": "Block",
      "type": "object"
    },
    "CalendarRef": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "content_hash"
      ],
      "title": "CalendarRef",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "metric_ref": {
          "$ref": "#/$defs/MetricRef"
        },
        "local_store_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Store Ids"
        },
        "population_binding": {
          "default": null,
          "title": "Population Binding",
          "type": "null"
        },
        "target_action_binding": {
          "default": null,
          "title": "Target Action Binding",
          "type": "null"
        }
      },
      "required": [
        "card_id",
        "metric_ref",
        "local_store_ids"
      ],
      "title": "Card",
      "type": "object"
    },
    "CardComparisonV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "card-comparison/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "mode": {
          "enum": [
            "temporal",
            "pair"
          ],
          "title": "Mode",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ComparisonSide"
        },
        "right": {
          "$ref": "#/$defs/ComparisonSide"
        },
        "comparability_status": {
          "enum": [
            "comparable",
            "descriptive",
            "unavailable"
          ],
          "title": "Comparability Status",
          "type": "string"
        },
        "buckets": {
          "items": {
            "$ref": "#/$defs/ComparisonBucket"
          },
          "title": "Buckets",
          "type": "array"
        },
        "totals": {
          "$ref": "#/$defs/ComparisonValues"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "manifest": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "schema_version",
        "mode",
        "left",
        "right",
        "comparability_status",
        "buckets",
        "totals",
        "coverage",
        "manifest"
      ],
      "title": "CardComparisonV1",
      "type": "object"
    },
    "CardResultBinding": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "metric_ref": {
          "$ref": "#/$defs/MetricRef"
        },
        "result": {
          "$ref": "#/$defs/ResultRef"
        },
        "effective_context_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effective Context Hash",
          "type": "string"
        },
        "configuration_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Hash",
          "type": "string"
        },
        "bucket_projection": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt"
          ],
          "title": "Bucket Projection",
          "type": "string"
        },
        "unit": {
          "enum": [
            "EUR",
            "receipt",
            "EUR/receipt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/NumberFormat"
        },
        "readiness": {
          "enum": [
            "ready",
            "no_data",
            "comparison_unavailable"
          ],
          "title": "Readiness",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "metric_ref",
        "result",
        "effective_context_hash",
        "configuration_hash",
        "bucket_projection",
        "unit",
        "format",
        "readiness"
      ],
      "title": "CardResultBinding",
      "type": "object"
    },
    "ChartSeriesRef": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "field": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt",
            "left",
            "right",
            "absolute_delta",
            "relative_delta_percent"
          ],
          "title": "Field",
          "type": "string"
        },
        "axis": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Axis",
          "type": "string"
        },
        "unit": {
          "enum": [
            "EUR",
            "receipt",
            "EUR/receipt",
            "percent"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "artifact",
        "field",
        "axis",
        "unit"
      ],
      "title": "ChartSeriesRef",
      "type": "object"
    },
    "ComparisonBucket": {
      "additionalProperties": false,
      "properties": {
        "left_coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "right_coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "left": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Left"
        },
        "right": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right"
        },
        "absolute_delta": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Delta"
        },
        "relative_delta_percent": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Delta Percent"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "bucket_id": {
          "title": "Bucket Id",
          "type": "string"
        }
      },
      "required": [
        "left_coverage",
        "right_coverage",
        "left",
        "right",
        "absolute_delta",
        "relative_delta_percent",
        "reason_codes",
        "bucket_id"
      ],
      "title": "ComparisonBucket",
      "type": "object"
    },
    "ComparisonPeriod": {
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        }
      },
      "required": [
        "starts_on",
        "ends_on"
      ],
      "title": "ComparisonPeriod",
      "type": "object"
    },
    "ComparisonSide": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "metric_ref": {
          "$ref": "#/$defs/MetricRef"
        },
        "result": {
          "$ref": "#/$defs/ResultRef"
        },
        "unit": {
          "enum": [
            "EUR",
            "receipt",
            "EUR/receipt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/NumberFormat"
        },
        "context": {
          "$ref": "#/$defs/EffectiveContext"
        },
        "baseline_dates": {
          "anyOf": [
            {
              "items": {
                "format": "date",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Dates"
        }
      },
      "required": [
        "card_id",
        "metric_ref",
        "result",
        "unit",
        "format",
        "context",
        "baseline_dates"
      ],
      "title": "ComparisonSide",
      "type": "object"
    },
    "ComparisonValues": {
      "additionalProperties": false,
      "properties": {
        "left_coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "right_coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "left": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Left"
        },
        "right": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right"
        },
        "absolute_delta": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Delta"
        },
        "relative_delta_percent": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Delta Percent"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "left_coverage",
        "right_coverage",
        "left",
        "right",
        "absolute_delta",
        "relative_delta_percent",
        "reason_codes"
      ],
      "title": "ComparisonValues",
      "type": "object"
    },
    "ConfiguredReportV2": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "configured-report/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "creator_principal_id": {
          "format": "uuid",
          "title": "Creator Principal Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "semantic_dataset_version_id": {
          "format": "uuid",
          "title": "Semantic Dataset Version Id",
          "type": "string"
        },
        "common_context": {
          "$ref": "#/$defs/QueryContext"
        },
        "grain": {
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "half_year",
            "year"
          ],
          "title": "Grain",
          "type": "string"
        },
        "calendar_ref": {
          "$ref": "#/$defs/CalendarRef"
        },
        "calendar_basis": {
          "enum": [
            "calendar",
            "fiscal"
          ],
          "title": "Calendar Basis",
          "type": "string"
        },
        "worksets": {
          "items": {
            "$ref": "#/$defs/Workset"
          },
          "maxItems": 20,
          "title": "Worksets",
          "type": "array"
        },
        "default_workset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Default Workset Id"
        },
        "selection": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "pair": "#/$defs/PairSelection",
                  "single": "#/$defs/SingleSelection"
                },
                "propertyName": "mode"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SingleSelection"
                },
                {
                  "$ref": "#/$defs/PairSelection"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Selection"
        },
        "brand_profile": {
          "$ref": "#/$defs/Reference"
        },
        "company_pack": {
          "$ref": "#/$defs/Reference"
        },
        "base_snapshot_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaseSnapshotRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "report_id",
        "creator_principal_id",
        "title",
        "semantic_dataset_version_id",
        "common_context",
        "grain",
        "calendar_ref",
        "calendar_basis",
        "worksets",
        "default_workset_id",
        "selection",
        "brand_profile",
        "company_pack",
        "base_snapshot_ref"
      ],
      "title": "ConfiguredReportV2",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "expected_days": {
          "minimum": 0,
          "title": "Expected Days",
          "type": "integer"
        },
        "calendar_days": {
          "minimum": 0,
          "title": "Calendar Days",
          "type": "integer"
        },
        "declared_complete_days": {
          "minimum": 0,
          "title": "Declared Complete Days",
