        },
        "navigation_mode": {
          "const": "tabs",
          "title": "Navigation Mode",
          "type": "string"
        },
        "default_page_id": {
          "format": "uuid",
          "title": "Default Page Id",
          "type": "string"
        },
        "chapters": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Chapters",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "title": "Pages",
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        },
        "brand_profile_version_id": {
          "format": "uuid",
          "title": "Brand Profile Version Id",
          "type": "string"
        },
        "access_policy_id": {
          "format": "uuid",
          "title": "Access Policy Id",
          "type": "string"
        },
        "filter_scope_bindings": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Filter Scope Bindings",
          "type": "array"
        }
      },
      "required": [
        "analytical_document_version_id",
        "analytical_document_id",
        "workspace_id",
        "profile",
        "composition_schema_version",
        "source_owner_ref",
        "navigation_mode",
        "default_page_id",
        "chapters",
        "pages",
        "sections",
        "blocks",
        "brand_profile_version_id",
        "access_policy_id",
        "filter_scope_bindings"
      ],
      "title": "AnalyticalDocumentCompositionV1",
      "type": "object"
    },
    "AnalyticalDocumentCompositionV2": {
      "additionalProperties": false,
      "properties": {
        "composition_schema_version": {
          "const": 2,
          "title": "Composition Schema Version",
          "type": "integer"
        },
        "analytical_document_version_id": {
          "format": "uuid",
          "title": "Analytical Document Version Id",
          "type": "string"
        },
        "analytical_document_id": {
          "format": "uuid",
          "title": "Analytical Document Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "profile": {
          "const": "workbook_report",
          "title": "Profile",
          "type": "string"
        },
        "source_owner_ref": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Owner Ref",
          "type": "object"
        },
        "navigation_mode": {
          "const": "tabs",
          "title": "Navigation Mode",
          "type": "string"
        },
        "default_page_id": {
          "format": "uuid",
          "title": "Default Page Id",
          "type": "string"
        },
        "chapters": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Chapters",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "title": "Pages",
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/WorkspaceSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        },
        "brand_profile_version_id": {
          "format": "uuid",
          "title": "Brand Profile Version Id",
          "type": "string"
        },
        "access_policy_id": {
          "format": "uuid",
          "title": "Access Policy Id",
          "type": "string"
        },
        "filter_scope_bindings": {
          "items": {
            "$ref": "#/$defs/WorkspaceFilterBinding"
          },
