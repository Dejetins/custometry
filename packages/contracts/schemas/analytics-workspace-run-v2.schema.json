{
  "$defs": {
    "CalendarRef": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "content_hash"
      ],
      "title": "CalendarRef",
      "type": "object"
    },
    "MetricRef": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "version_id",
        "content_hash"
      ],
      "title": "MetricRef",
      "type": "object"
    },
    "QueryContext": {
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "store_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Store Ids"
        }
      },
      "required": [
        "starts_on",
        "ends_on",
        "store_ids"
      ],
      "title": "QueryContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "semantic_dataset_version_id": {
      "format": "uuid",
      "title": "Semantic Dataset Version Id",
      "type": "string"
    },
    "common": {
      "$ref": "#/$defs/QueryContext"
    },
    "local_store_ids": {
      "anyOf": [
        {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 1000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Local Store Ids"
    },
    "grain": {
      "enum": [
        "day",
        "week",
        "month",
        "quarter",
        "half_year",
        "year"
      ],
      "title": "Grain",
      "type": "string"
    },
    "calendar_ref": {
      "$ref": "#/$defs/CalendarRef"
    },
    "calendar_basis": {
      "enum": [
        "calendar",
        "fiscal"
      ],
      "title": "Calendar Basis",
      "type": "string"
    },
    "alignment": {
      "enum": [
        "none",
        "previous_year_same_dates"
      ],
      "title": "Alignment",
      "type": "string"
    },
    "metric_refs": {
      "items": {
        "$ref": "#/$defs/MetricRef"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Metric Refs",
      "type": "array"
    }
  },
  "required": [
    "semantic_dataset_version_id",
    "common",
    "local_store_ids",
    "grain",
    "calendar_ref",
    "calendar_basis",
    "alignment",
    "metric_refs"
  ],
  "title": "WorkspaceRunRequest",
  "type": "object"
}
