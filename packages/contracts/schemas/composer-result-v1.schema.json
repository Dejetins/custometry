{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CalendarRef": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "content_hash"
      ],
      "title": "CalendarRef",
      "type": "object"
    },
    "CardComparisonV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "card-comparison/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "mode": {
          "enum": [
            "temporal",
            "pair"
          ],
          "title": "Mode",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ComparisonSide"
        },
        "right": {
          "$ref": "#/$defs/ComparisonSide"
        },
        "comparability_status": {
          "enum": [
            "comparable",
            "descriptive",
            "unavailable"
          ],
          "title": "Comparability Status",
          "type": "string"
        },
        "buckets": {
          "items": {
            "$ref": "#/$defs/ComparisonBucket"
          },
          "title": "Buckets",
          "type": "array"
        },
        "totals": {
          "$ref": "#/$defs/ComparisonValues"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "manifest": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "schema_version",
        "mode",
        "left",
        "right",
        "comparability_status",
        "buckets",
        "totals",
        "coverage",
        "manifest"
      ],
      "title": "CardComparisonV1",
      "type": "object"
    },
    "CardResultBinding": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "metric_ref": {
          "$ref": "#/$defs/MetricRef"
        },
        "result": {
          "$ref": "#/$defs/ResultRef"
        },
        "effective_context_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effective Context Hash",
          "type": "string"
        },
        "configuration_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Hash",
          "type": "string"
        },
        "bucket_projection": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt"
          ],
          "title": "Bucket Projection",
          "type": "string"
        },
        "unit": {
          "enum": [
            "EUR",
            "receipt",
            "EUR/receipt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/NumberFormat"
        },
        "readiness": {
          "enum": [
            "ready",
            "no_data",
            "comparison_unavailable"
          ],
          "title": "Readiness",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "metric_ref",
        "result",
        "effective_context_hash",
        "configuration_hash",
        "bucket_projection",
        "unit",
        "format",
        "readiness"
      ],
      "title": "CardResultBinding",
      "type": "object"
    },
    "ComparisonBucket": {
      "additionalProperties": false,
      "properties": {
        "left_coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "right_coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "left": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Left"
        },
        "right": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right"
        },
        "absolute_delta": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Delta"
        },
        "relative_delta_percent": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Delta Percent"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "bucket_id": {
          "title": "Bucket Id",
          "type": "string"
        }
      },
      "required": [
        "left_coverage",
        "right_coverage",
        "left",
        "right",
        "absolute_delta",
        "relative_delta_percent",
        "reason_codes",
        "bucket_id"
      ],
      "title": "ComparisonBucket",
      "type": "object"
    },
    "ComparisonPeriod": {
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        }
      },
      "required": [
        "starts_on",
        "ends_on"
      ],
      "title": "ComparisonPeriod",
      "type": "object"
    },
    "ComparisonSide": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "metric_ref": {
          "$ref": "#/$defs/MetricRef"
        },
        "result": {
          "$ref": "#/$defs/ResultRef"
        },
        "unit": {
          "enum": [
            "EUR",
            "receipt",
            "EUR/receipt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/NumberFormat"
        },
        "context": {
          "$ref": "#/$defs/EffectiveContext"
        },
        "baseline_dates": {
          "anyOf": [
            {
              "items": {
                "format": "date",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Dates"
        }
      },
      "required": [
        "card_id",
        "metric_ref",
        "result",
        "unit",
        "format",
        "context",
        "baseline_dates"
      ],
      "title": "ComparisonSide",
      "type": "object"
    },
    "ComparisonValues": {
      "additionalProperties": false,
      "properties": {
        "left_coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "right_coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "left": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Left"
        },
        "right": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right"
        },
        "absolute_delta": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Delta"
        },
        "relative_delta_percent": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Delta Percent"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "left_coverage",
        "right_coverage",
        "left",
        "right",
        "absolute_delta",
        "relative_delta_percent",
        "reason_codes"
      ],
      "title": "ComparisonValues",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "expected_days": {
          "minimum": 0,
          "title": "Expected Days",
          "type": "integer"
        },
        "calendar_days": {
          "minimum": 0,
          "title": "Calendar Days",
          "type": "integer"
        },
        "declared_complete_days": {
          "minimum": 0,
          "title": "Declared Complete Days",
          "type": "integer"
        },
        "observed_days": {
          "minimum": 0,
          "title": "Observed Days",
          "type": "integer"
        },
        "eligible_receipts": {
          "minimum": 0,
          "title": "Eligible Receipts",
          "type": "integer"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "state",
        "expected_days",
        "calendar_days",
        "declared_complete_days",
        "observed_days",
        "eligible_receipts",
        "reason_codes"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DayAlignment": {
      "additionalProperties": false,
      "properties": {
        "current_date": {
          "format": "date",
          "title": "Current Date",
          "type": "string"
        },
        "baseline_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Date"
        }
      },
      "required": [
        "current_date",
        "baseline_date"
      ],
      "title": "DayAlignment",
      "type": "object"
    },
    "EffectiveContext": {
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "time_comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedTemporalSpecV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Hash"
        },
        "store_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Store Ids",
          "type": "array"
        },
        "grain": {
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "half_year",
            "year"
          ],
          "title": "Grain",
          "type": "string"
        },
        "calendar_ref": {
          "$ref": "#/$defs/CalendarRef"
        },
        "calendar_basis": {
          "enum": [
            "calendar",
            "fiscal"
          ],
          "title": "Calendar Basis",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "maxLength": 128,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "week_start": {
          "const": "monday",
          "default": "monday",
          "title": "Week Start",
          "type": "string"
        },
        "alignment": {
          "enum": [
            "none",
            "previous_year_same_dates"
          ],
          "title": "Alignment",
          "type": "string"
        }
      },
      "required": [
        "starts_on",
        "ends_on",
        "store_ids",
        "grain",
        "calendar_ref",
        "calendar_basis",
        "alignment"
      ],
      "title": "EffectiveContext",
      "type": "object"
    },
    "MetricRef": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "version_id",
        "content_hash"
      ],
      "title": "MetricRef",
      "type": "object"
    },
    "MetricValues": {
      "additionalProperties": false,
      "properties": {
        "net_revenue": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Net Revenue"
        },
        "receipt_count": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receipt Count"
        },
        "average_receipt": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Average Receipt"
        }
      },
      "required": [
        "net_revenue",
        "receipt_count",
        "average_receipt"
      ],
      "title": "MetricValues",
      "type": "object"
    },
    "NumberFormat": {
      "additionalProperties": false,
      "properties": {
        "decimal_places": {
          "maximum": 2,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        }
      },
      "required": [
        "decimal_places"
      ],
      "title": "NumberFormat",
      "type": "object"
    },
    "ReceiptSelectionEvidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "receipt-selection-evidence/v2",
          "default": "receipt-selection-evidence/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "count_scope": {
          "const": "authorized_dataset",
          "default": "authorized_dataset",
          "title": "Count Scope",
          "type": "string"
        },
        "request_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Hash",
          "type": "string"
        },
        "matched_count": {
          "minimum": 0,
          "title": "Matched Count",
          "type": "integer"
        },
        "not_matched_count": {
          "minimum": 0,
          "title": "Not Matched Count",
          "type": "integer"
        },
        "unknown_count": {
          "minimum": 0,
          "title": "Unknown Count",
          "type": "integer"
        },
        "authorized_count": {
          "minimum": 0,
          "title": "Authorized Count",
          "type": "integer"
        },
        "limitation_codes": {
          "items": {
            "type": "string"
          },
          "title": "Limitation Codes",
          "type": "array"
        }
      },
      "required": [
        "request_hash",
        "matched_count",
        "not_matched_count",
        "unknown_count",
        "authorized_count",
        "limitation_codes"
      ],
      "title": "ReceiptSelectionEvidence",
      "type": "object"
    },
    "ResolvedComparisonPeriod": {
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "ends_at_exclusive": {
          "format": "date-time",
          "title": "Ends At Exclusive",
          "type": "string"
        },
        "local_date_count": {
          "maximum": 366,
          "minimum": 1,
          "title": "Local Date Count",
          "type": "integer"
        },
        "elapsed_seconds": {
          "minimum": 1,
          "title": "Elapsed Seconds",
          "type": "integer"
        }
      },
      "required": [
        "starts_on",
        "ends_on",
        "starts_at",
        "ends_at_exclusive",
        "local_date_count",
        "elapsed_seconds"
      ],
      "title": "ResolvedComparisonPeriod",
      "type": "object"
    },
    "ResolvedTemporalSpecV2": {
      "additionalProperties": false,
      "properties": {
        "date_mapping": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TemporalDatePairV2"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Mapping"
        },
        "schema_version": {
          "const": "resolved-time-comparison/v2",
          "default": "resolved-time-comparison/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/TemporalSettingsV2"
        },
        "current_period": {
          "$ref": "#/$defs/ResolvedComparisonPeriod"
        },
        "comparison_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedComparisonPeriod"
            },
            {
              "type": "null"
            }
          ]
        },
        "calendar_ref": {
          "$ref": "#/$defs/CalendarRef"
        },
        "calendar_basis": {
          "enum": [
            "calendar",
            "fiscal"
          ],
          "title": "Calendar Basis",
          "type": "string"
        },
        "grain": {
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "half_year",
            "year"
          ],
          "title": "Grain",
          "type": "string"
        },
        "timezone": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "overlap_local_dates": {
          "minimum": 0,
          "title": "Overlap Local Dates",
          "type": "integer"
        },
        "duration_difference_local_dates": {
          "title": "Duration Difference Local Dates",
          "type": "integer"
        },
        "limitation_codes": {
          "items": {
            "type": "string"
          },
          "title": "Limitation Codes",
          "type": "array"
        }
      },
      "required": [
        "settings",
        "current_period",
        "comparison_period",
        "calendar_ref",
        "calendar_basis",
        "grain",
        "timezone",
        "overlap_local_dates",
        "duration_difference_local_dates",
        "limitation_codes"
      ],
      "title": "ResolvedTemporalSpecV2",
      "type": "object"
    },
    "ResultRef": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "schema_version": {
          "const": "metric-workspace/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "result_id",
        "schema_version",
        "manifest"
      ],
      "title": "ResultRef",
      "type": "object"
    },
    "TemporalArtifactV2": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "time-comparison-artifact/v2",
          "default": "time-comparison-artifact/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "request_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Hash",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/ResolvedTemporalSpecV2"
        },
        "semantic_dataset_version_id": {
          "format": "uuid",
          "title": "Semantic Dataset Version Id",
          "type": "string"
        },
        "metric_refs": {
          "items": {
            "$ref": "#/$defs/MetricRef"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "normalized_filter_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Normalized Filter Hash",
          "type": "string"
        },
        "evaluated_current_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Evaluated Current Dates",
          "type": "array"
        },
        "evaluated_comparison_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Evaluated Comparison Dates",
          "type": "array"
        },
        "buckets": {
          "items": {
            "$ref": "#/$defs/TemporalPairBucketV2"
          },
          "title": "Buckets",
          "type": "array"
        },
        "changes": {
          "$ref": "#/$defs/TemporalMetricChangesV2"
        },
        "comparability_status": {
          "enum": [
