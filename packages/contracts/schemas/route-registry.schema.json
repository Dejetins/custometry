{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custometry.local/schemas/route-registry.schema.json",
  "title": "Custometry UI route registry",
  "type": "object",
  "required": ["schema_version", "workspace_key_parameter", "routes"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "workspace_key_parameter": { "const": ":workspaceKey" },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    },
    "foundation_utility_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "title_key", "release", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "title_key": {
          "type": "string",
          "pattern": "^(UI-[A-Z]+-[0-9]{3}|FOUNDATION-[A-Z][A-Z-]*)$"
        },
        "release": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "foundation", "implemented"] }
      }
    }
  }
}
