{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CalendarRef": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "content_hash"
      ],
      "title": "CalendarRef",
      "type": "object"
    },
    "CardResultBinding": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "metric_ref": {
          "$ref": "#/$defs/MetricRef"
        },
        "result": {
          "$ref": "#/$defs/ResultRef"
        },
        "effective_context_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effective Context Hash",
          "type": "string"
        },
        "configuration_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Hash",
          "type": "string"
        },
        "bucket_projection": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt"
          ],
          "title": "Bucket Projection",
          "type": "string"
        },
        "unit": {
          "enum": [
            "EUR",
            "receipt",
            "EUR/receipt"
          ],
          "title": "Unit",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/NumberFormat"
        },
        "readiness": {
          "enum": [
            "ready",
            "no_data",
            "comparison_unavailable"
          ],
          "title": "Readiness",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "metric_ref",
        "result",
        "effective_context_hash",
        "configuration_hash",
        "bucket_projection",
        "unit",
        "format",
        "readiness"
      ],
      "title": "CardResultBinding",
      "type": "object"
    },
    "MetricRef": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "version_id",
        "content_hash"
      ],
      "title": "MetricRef",
      "type": "object"
    },
    "NumberFormat": {
      "additionalProperties": false,
      "properties": {
        "decimal_places": {
          "maximum": 2,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        }
      },
      "required": [
        "decimal_places"
      ],
      "title": "NumberFormat",
      "type": "object"
    },
    "PairSelection": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "pair",
          "title": "Mode",
          "type": "string"
        },
        "left_card_id": {
          "format": "uuid",
          "title": "Left Card Id",
          "type": "string"
        },
        "right_card_id": {
          "format": "uuid",
          "title": "Right Card Id",
          "type": "string"
        },
        "display": {
          "const": "series",
          "title": "Display",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "left_card_id",
        "right_card_id",
        "display"
      ],
      "title": "PairSelection",
      "type": "object"
    },
    "ResultRef": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "schema_version": {
          "const": "metric-workspace/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "result_id",
        "schema_version",
        "manifest"
      ],
      "title": "ResultRef",
      "type": "object"
    },
    "SingleSelection": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "single",
          "title": "Mode",
          "type": "string"
        },
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "temporal": {
          "enum": [
            "none",
            "previous_year_same_dates"
          ],
          "title": "Temporal",
          "type": "string"
        },
        "display": {
          "enum": [
            "series",
            "delta_trend"
          ],
          "title": "Display",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "card_id",
        "temporal",
        "display"
      ],
      "title": "SingleSelection",
      "type": "object"
    },
    "ViewDisplay": {
      "additionalProperties": false,
      "properties": {
        "active_workset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Workset Id"
        },
        "selection": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "pair": "#/$defs/PairSelection",
                  "single": "#/$defs/SingleSelection"
                },
                "propertyName": "mode"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SingleSelection"
                },
                {
                  "$ref": "#/$defs/PairSelection"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Selection"
        },
        "card_order": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Card Order",
          "type": "array"
        },
        "hidden_card_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Hidden Card Ids",
          "type": "array"
        },
        "representation": {
          "enum": [
            "chart",
            "table"
          ],
          "title": "Representation",
          "type": "string"
        },
        "density": {
          "enum": [
            "comfortable",
            "compact"
          ],
          "title": "Density",
          "type": "string"
        }
      },
      "required": [
        "active_workset_id",
        "selection",
        "card_order",
        "hidden_card_ids",
        "representation",
        "density"
      ],
      "title": "ViewDisplay",
      "type": "object"
    },
    "ViewQueryContext": {
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "store_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Store Ids"
        },
        "grain": {
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "half_year",
            "year"
          ],
          "title": "Grain",
          "type": "string"
        }
      },
      "required": [
        "starts_on",
        "ends_on",
        "store_ids",
        "grain"
      ],
      "title": "ViewQueryContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "saved-view/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "saved_view_id": {
      "format": "uuid",
      "title": "Saved View Id",
      "type": "string"
    },
    "version_id": {
      "format": "uuid",
      "title": "Version Id",
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "owner_principal_id": {
      "format": "uuid",
      "title": "Owner Principal Id",
      "type": "string"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "document_version_id": {
      "format": "uuid",
      "title": "Document Version Id",
      "type": "string"
    },
    "document_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Document Content Hash",
      "type": "string"
    },
    "calendar_ref": {
      "$ref": "#/$defs/CalendarRef"
    },
    "calendar_basis": {
      "enum": [
        "calendar",
        "fiscal"
      ],
      "title": "Calendar Basis",
      "type": "string"
    },
    "page_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Page Ids",
      "type": "array"
    },
    "result_scope": {
      "items": {
        "$ref": "#/$defs/CardResultBinding"
      },
      "title": "Result Scope",
      "type": "array"
    },
    "query_context": {
      "$ref": "#/$defs/ViewQueryContext"
    },
    "display": {
      "$ref": "#/$defs/ViewDisplay"
    }
  },
  "required": [
    "schema_version",
    "saved_view_id",
    "version_id",
    "revision",
    "workspace_id",
    "owner_principal_id",
    "report_id",
    "document_version_id",
    "document_content_hash",
    "calendar_ref",
    "calendar_basis",
    "page_ids",
    "result_scope",
    "query_context",
    "display"
  ],
  "title": "SavedViewV1",
  "type": "object"
}
