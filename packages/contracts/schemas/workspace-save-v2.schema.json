{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BaseSnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "version_id",
        "snapshot_id",
        "manifest"
      ],
      "title": "BaseSnapshotRef",
      "type": "object"
    },
    "CalendarRef": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "content_hash"
      ],
      "title": "CalendarRef",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "metric_ref": {
          "$ref": "#/$defs/MetricRef"
        },
        "local_store_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Store Ids"
        },
        "population_binding": {
          "default": null,
          "title": "Population Binding",
          "type": "null"
        },
        "target_action_binding": {
          "default": null,
          "title": "Target Action Binding",
          "type": "null"
        }
      },
      "required": [
        "card_id",
        "metric_ref",
        "local_store_ids"
      ],
      "title": "Card",
      "type": "object"
    },
    "ConfiguredReportV2": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "configured-report/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "creator_principal_id": {
          "format": "uuid",
          "title": "Creator Principal Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "semantic_dataset_version_id": {
          "format": "uuid",
          "title": "Semantic Dataset Version Id",
          "type": "string"
        },
        "common_context": {
          "$ref": "#/$defs/QueryContext"
        },
        "grain": {
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "half_year",
            "year"
          ],
          "title": "Grain",
          "type": "string"
        },
        "calendar_ref": {
          "$ref": "#/$defs/CalendarRef"
        },
        "calendar_basis": {
          "enum": [
            "calendar",
            "fiscal"
          ],
          "title": "Calendar Basis",
          "type": "string"
        },
        "worksets": {
          "items": {
            "$ref": "#/$defs/Workset"
          },
          "maxItems": 20,
          "title": "Worksets",
          "type": "array"
        },
        "default_workset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Default Workset Id"
        },
        "selection": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "pair": "#/$defs/PairSelection",
                  "single": "#/$defs/SingleSelection"
                },
                "propertyName": "mode"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SingleSelection"
                },
                {
                  "$ref": "#/$defs/PairSelection"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Selection"
        },
        "brand_profile": {
          "$ref": "#/$defs/Reference"
        },
        "company_pack": {
          "$ref": "#/$defs/Reference"
        },
        "base_snapshot_ref": {
          "$ref": "#/$defs/BaseSnapshotRef"
        }
      },
      "required": [
        "schema_version",
        "report_id",
        "creator_principal_id",
        "title",
        "semantic_dataset_version_id",
        "common_context",
        "grain",
        "calendar_ref",
        "calendar_basis",
        "worksets",
        "default_workset_id",
        "selection",
        "brand_profile",
        "company_pack",
        "base_snapshot_ref"
      ],
      "title": "ConfiguredReportV2",
      "type": "object"
    },
    "LocalizedName": {
      "additionalProperties": false,
      "properties": {
        "ru": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Ru",
          "type": "string"
        },
        "en": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "ru",
        "en"
      ],
      "title": "LocalizedName",
      "type": "object"
    },
    "MetricRef": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "enum": [
            "net_revenue",
            "receipt_count",
            "average_receipt"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "version_id",
        "content_hash"
      ],
      "title": "MetricRef",
      "type": "object"
    },
    "PairSelection": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "pair",
          "title": "Mode",
          "type": "string"
        },
        "left_card_id": {
          "format": "uuid",
          "title": "Left Card Id",
          "type": "string"
        },
        "right_card_id": {
          "format": "uuid",
          "title": "Right Card Id",
          "type": "string"
        },
        "display": {
          "const": "series",
          "title": "Display",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "left_card_id",
        "right_card_id",
        "display"
      ],
      "title": "PairSelection",
      "type": "object"
    },
    "QueryContext": {
      "additionalProperties": false,
      "properties": {
        "starts_on": {
          "format": "date",
          "title": "Starts On",
          "type": "string"
        },
        "ends_on": {
          "format": "date",
          "title": "Ends On",
          "type": "string"
        },
        "store_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Store Ids"
        }
      },
      "required": [
        "starts_on",
        "ends_on",
        "store_ids"
      ],
      "title": "QueryContext",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "content_hash"
      ],
      "title": "Reference",
      "type": "object"
    },
    "SingleSelection": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "single",
          "title": "Mode",
          "type": "string"
        },
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "temporal": {
          "enum": [
            "none",
            "previous_year_same_dates"
          ],
          "title": "Temporal",
          "type": "string"
        },
        "display": {
          "enum": [
            "series",
            "delta_trend"
          ],
          "title": "Display",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "card_id",
        "temporal",
        "display"
      ],
      "title": "SingleSelection",
      "type": "object"
    },
    "Workset": {
      "additionalProperties": false,
      "properties": {
        "workset_id": {
          "format": "uuid",
          "title": "Workset Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/LocalizedName"
        },
        "visibility": {
          "const": "personal",
          "title": "Visibility",
          "type": "string"
        },
        "owner_principal_id": {
          "format": "uuid",
          "title": "Owner Principal Id",
          "type": "string"
        },
        "cards": {
          "items": {
            "$ref": "#/$defs/Card"
          },
          "maxItems": 50,
          "title": "Cards",
          "type": "array"
        }
      },
      "required": [
        "workset_id",
        "name",
        "visibility",
        "owner_principal_id",
        "cards"
      ],
      "title": "Workset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "configured-report/v2",
      "title": "Contract Version",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/ConfiguredReportV2"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "expected_saved_view_revision": {
      "minimum": 0,
      "title": "Expected Saved View Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "format": "uuid",
      "title": "Idempotency Key",
      "type": "string"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "result_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Result Ids",
      "type": "array"
    },
    "chart_specs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "Chart Specs",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "definition",
    "expected_revision",
    "expected_saved_view_revision",
    "idempotency_key",
    "configuration_hash",
    "result_ids",
    "chart_specs"
  ],
  "title": "WorkspaceSaveRequest",
  "type": "object"
}
