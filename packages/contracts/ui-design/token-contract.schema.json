{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custometry.local/contracts/ui-design/token-contract.schema.json",
  "title": "Custometry UI token contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "token_version", "themes", "tokens"],
  "properties": {
    "schema_version": {"const": "custometry.ui-design.tokens/v1"},
    "token_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "object"},
    "figma_identity": {"type": "object"},
    "themes": {
      "type": "array",
      "items": {"enum": ["abyss", "graphite", "frost", "paper"]},
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "values"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)+$"},
          "type": {"enum": ["color", "number", "string"]},
          "values": {"type": "object", "minProperties": 1},
          "description": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    }
  }
}
